{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kinder Signs Generate Content Pack output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "sign_id", "source_context_id", "source_reference", "prompt_version", "generation_method", "generation_mode", "language", "family_guidance", "try_it_during", "routine_context", "teacher_message", "family_message", "flashcard_copy", "review_status", "requires_human_review", "automatic_publication"],
  "properties": {
    "schema_version": {"const": "1.0"}, "run_id": {"type": "string", "pattern": "^content_[A-Za-z0-9_-]+$"},
    "sign_id": {"type": "string", "minLength": 1}, "source_context_id": {"type": "string", "minLength": 1}, "source_reference": {"type": "string", "minLength": 1}, "prompt_version": {"const": "kinder_signs_content_pack_v1"},
    "generation_method": {"enum": ["human", "llm_assisted"]}, "generation_mode": {"enum": ["LIVE", "DRY_RUN", "NOT_APPLICABLE"]},
    "language": {"enum": ["es", "en", "bilingual"]},
    "family_guidance": {"$ref": "#/$defs/bilingualText"}, "try_it_during": {"$ref": "#/$defs/bilingualText"},
    "routine_context": {"$ref": "#/$defs/bilingualText"}, "teacher_message": {"$ref": "#/$defs/bilingualText"}, "family_message": {"$ref": "#/$defs/bilingualText"},
    "flashcard_copy": {"type": "object", "additionalProperties": false, "required": ["primary_label", "secondary_label"], "properties": {"primary_label": {"type": "string"}, "secondary_label": {"type": "string"}}},
    "review_status": {"enum": ["READY_FOR_REVIEW", "APPROVED", "CHANGES_REQUESTED"]}, "requires_human_review": {"const": true}, "automatic_publication": {"const": false}
  },
  "$defs": {"bilingualText": {"type": "object", "additionalProperties": false, "required": ["en", "es"], "properties": {"en": {"type": "string", "minLength": 1}, "es": {"type": "string", "minLength": 1}}}}
}
